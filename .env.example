# Porta em que o servidor backend irá rodar
PORT=3000

# String de conexão do MongoDB
# Para desenvolvimento local: MONGODB_URI=mongodb://localhost:27017/ruago_dev
# Para produção/staging, use sua string de conexão do Atlas ou servidor MongoDB remoto
MONGO_URI=mongodb://localhost:27017/ruago_dev

# Segredo para assinar os JSON Web Tokens (JWT)
# IMPORTANTE: Use um valor longo, aleatório e seguro em produção!
JWT_SECRET=seu_segredo_super_secreto_para_jwt_dev

# Chave da API do Google para usar o Gemini
# Obtenha em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=SUA_API_KEY_DO_GOOGLE_GEMINI

# URL do frontend em produção (para configuração do CORS no backend)
# Exemplo: FRONTEND_PROD_URL=https://app.ruago.com
FRONTEND_PROD_URL=http://localhost:YOUR_FRONTEND_PORT_IF_DIFFERENT_OR_SAME_AS_BACKEND

# Define o ambiente da aplicação (development, production, test)
NODE_ENV=development
